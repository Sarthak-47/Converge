{
  "name": "converge",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/collab"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @converge/web",
    "dev:collab": "npm run dev --workspace @converge/collab",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspace @converge/collab && npm run build --workspace @converge/web"
  }
}
