{
  "name": "@converge/agent-runner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Runs coding-agent turns on the Claude API or an OpenAI-compatible provider; agents edit live documents as Yjs clients (design §13).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "fake-model": "node dist/testing/fakeModelMain.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@hocuspocus/provider": "^4.8.0",
    "fast-diff": "^1.3.0",
    "ws": "^8.23.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  }
}
