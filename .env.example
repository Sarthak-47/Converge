# Local development only. Copy to .env to override; never reuse these values elsewhere.
POSTGRES_USER=converge
POSTGRES_PASSWORD=converge
POSTGRES_DB=converge
# Shared secret for service-to-service calls (/internal). Use a long random value outside development.
INTERNAL_TOKEN=dev-internal-token
# The origin people open the app on; document sockets from other origins are refused.
PUBLIC_ORIGIN=http://localhost:8000
# AES-256 key (base64 of 32 bytes) that encrypts members' API keys and agent transcripts at rest.
# Generate your own outside development: openssl rand -base64 32
SECRETS_KEY=ZGV2ZWxvcG1lbnQtb25seS1zZWNyZXRzLWtleS0zMiE=
# Where the agent runner sends Claude API requests. Empty means the real API; tests use the fake model.
AGENT_MODEL_URL=
# Multiplies every API rate limit (login, sign-up, agent prompts, jobs, Git). Raise it when running the
# end-to-end suite or load tests locally, which sign up many users from one address.
RATE_LIMIT_SCALE=1
