# Local development only. Copy to .env to override; never reuse these values elsewhere.
POSTGRES_USER=converge
POSTGRES_PASSWORD=converge
POSTGRES_DB=converge
# Shared secret for service-to-service calls (/internal). Use a long random value outside development.
INTERNAL_TOKEN=dev-internal-token
# The origin people open the app on; document sockets from other origins are refused.
PUBLIC_ORIGIN=http://localhost:8000
